#!/usr/bin/env php
<?php

declare(strict_types=1);

use AdminBolt\PluginCli\Application;

// Works both as a project dependency and as a globally installed tool.
$autoloaders = [
    __DIR__ . '/../vendor/autoload.php',
    __DIR__ . '/../../../autoload.php',
];

$loaded = false;

foreach ($autoloaders as $autoloader) {
    if (is_file($autoloader)) {
        require $autoloader;
        $loaded = true;
        break;
    }
}

if (!$loaded) {
    fwrite(STDERR, "Dependencies are not installed. Run composer install.\n");
    exit(1);
}

exit((new Application())->run(array_slice($argv, 1)));
