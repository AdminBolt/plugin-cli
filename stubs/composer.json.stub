{
    "name": "{{vendor}}/{{id}}",
    "description": "{{description}}",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "adminbolt/plugin-sdk": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "{{namespace_json}}\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "{{namespace_json}}\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
