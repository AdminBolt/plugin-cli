<?php

/**
 * {{name}}
 *
 * Runs outside the panel: its own process, its own user, its own releases.
 */

declare(strict_types=1);

use {{namespace}}\Handler\ExampleHandler;
use {{namespace}}\Ui\ExamplePage;
use AdminBolt\Plugin\Plugin;

require __DIR__ . '/../vendor/autoload.php';

$plugin = Plugin::boot(__DIR__);

$plugin->register(new ExampleHandler($plugin));

// The page declared under "ui" in plugin.json. The slug here must match the
// slug there: the manifest puts it in the navigation, this fills it in.
$page = new ExamplePage($plugin);

$plugin->page('{{id}}', $page->render(...));
$plugin->action('refresh', $page->refresh(...));

$plugin->run();
